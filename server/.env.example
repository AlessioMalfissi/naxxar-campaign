PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=naxxar_campaign

# Shared password the whole table logs in with.
APP_PASSWORD=

# Secret used to sign the login session cookie. Optional - defaults to APP_PASSWORD
# if unset, but set it separately so rotating the login password doesn't also log
# everyone out.
# SESSION_SECRET=

# Set to serve the built Angular app (dist/naxxar-campaign/browser) from this
# same process in production. Leave unset for local dev, where the Angular
# dev server proxies /api to this server instead.
# STATIC_DIR=../dist/naxxar-campaign/browser
