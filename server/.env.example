# The Angular dev proxy (../proxy.conf.json) forwards /api here.
PORT=3000

# Public origin of the app. Session cookies are marked Secure and CSRF checks compare against this
# value, so production must set the real https:// origin.
# APP_ORIGIN=https://app.example.com

# Leave unset for the in-memory dev database (auto-seeded, resets on restart). Uncomment to use a
# real database in dev; `pn run server` always connects to MongoDB (defaulting to this local URI).
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=naxxar_campaign

# Google Identity Services client id. Leave unset to hide "Continue with Google" in the app.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com

# SMTP URL for password reset email, e.g. smtp://user:pass@smtp.example.com:587
# In development the reset link is logged to the console instead of sent.
# Production refuses to start without this.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Naxxar <no-reply@example.com>

# Set to true only behind a trusted reverse proxy, so rate limits key on the client address.
# TRUST_PROXY=false

# Development-only account seeded into the in-memory database. Never used with MongoDB.
# DEV_DM_EMAIL=dm@naxxar.local
# DEV_DM_PASSWORD=app
# DEV_CAMPAIGN_NAME=Naxxar

# Set to serve the built Angular app (dist/naxxar-campaign/browser) from this
# same process in production. Leave unset for local dev, where the Angular
# dev server proxies /api to this server instead.
# STATIC_DIR=../dist/naxxar-campaign/browser
